# Optional public identity, currently unconfirmed. Empty values are omitted.
PUBLIC_X_HANDLE=
PUBLIC_CONTRACT_ADDRESS=
# Loopback port. No secret or paid service is needed.
PORT=4317
# Optional local recording directory; default is ./runtime.
# RUNTIME_DIR=
# Continuous exhibit uses a real isolated Linux desktop (WSL Ubuntu on Windows).
# Run scripts/setup-desktop.sh inside Ubuntu once. Validation --fast is headless.
# EXHIBIT_WSL_DISTRO=Ubuntu
# Set 0 for explicit controller-only/headless operation; apparatus stays blank.
# EXHIBIT_DESKTOP=0
# Optional public experiment records, enabled only after destination/account setup.
RECORDER_REPOSITORY=SpecimenArchive/Specimen-Archive
RECORDER_ENABLED=0
