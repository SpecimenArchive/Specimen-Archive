# Public identity; this does not enable posting or transactions.
PUBLIC_X_HANDLE=SpecimenArchive
PUBLIC_CONTRACT_ADDRESS=
PORT=4317
# Optional isolated local recording directory; default ./runtime.
# RUNTIME_DIR=

# Local Linux/WSL desktop reproduction. See docs/WORKSTATION_CAPTURE.md.
# EXHIBIT_WSL_DISTRO=Ubuntu
# EXHIBIT_DESKTOP=0  # explicit headless check; no genuine desktop claim

# Current Windows VM profile: all services run on that VM.
# Use the private station preparation and start-backend.ps1 instructions.
# EXHIBIT_DESKTOP=windows
# EXHIBIT_OBSERVATION_PROFILE=1
# EXHIBIT_EXTERNAL_PROFILE=1
# EXHIBIT_WINDOWS_URL=http://127.0.0.1:4320
# EXHIBIT_WINDOWS_TOKEN_FILE=C:/private/specimen-worker-token.txt
# EXHIBIT_MEMORY_ENABLED=1
# EXHIBIT_LEARNING_MODE=frozen
# SPECIMEN_NARRATOR_CONFIG=C:/private/narrator.json
# Copy config/narrator.example.json OUTSIDE Git; fill the API key privately.

# Existing production publication uses the separate SYSTEM recorder.
RECORDER_REPOSITORY=SpecimenArchive/Specimen-Archive
RECORDER_ENABLED=0
# SPECIMEN_EXTERNAL_RECORDER=1
